CATALOG_DB_USERNAME=catalog
CATALOG_DB_PASSWORD=catalog_local_only_change_me
CATALOG_DB_PORT=5432
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog

ORDER_DB_USERNAME=orders
ORDER_DB_PASSWORD=orders_local_only_change_me
ORDER_DB_PORT=5434
ORDER_DB_URL=jdbc:postgresql://localhost:5434/orders

DELIVERY_DB_USERNAME=deliveries
DELIVERY_DB_PASSWORD=deliveries_local_only_change_me
DELIVERY_DB_PORT=5435
DELIVERY_DB_URL=jdbc:postgresql://localhost:5435/deliveries

USER_DB_USERNAME=users
USER_DB_PASSWORD=users_local_only_change_me
USER_DB_PORT=5436
USER_DB_URL=jdbc:postgresql://localhost:5436/users

PAYMENT_DB_USERNAME=payments
PAYMENT_DB_PASSWORD=payments_local_only_change_me
PAYMENT_DB_PORT=5437
PAYMENT_DB_URL=jdbc:postgresql://localhost:5437/payments

RABBITMQ_USERNAME=delivery
RABBITMQ_PASSWORD=rabbitmq_local_only_change_me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Management UI, bound to localhost only.
RABBITMQ_MANAGEMENT_PORT=15672
# How often Order publishes pending delivery requests from its outbox.
ORDER_OUTBOX_POLL_INTERVAL=500ms

# Generate locally with scripts/initialize-auth-secret.ps1; never commit the real key.
USER_AUTH_SECRET=

CATALOG_SERVICE_URL=http://localhost:8082
DELIVERY_SERVICE_URL=http://localhost:8085
PAYMENT_SERVICE_URL=http://localhost:8084
ORDER_REMOTE_TIMEOUT_MS=5000
# Keep below ORDER_REMOTE_TIMEOUT_MS so Order receives Payment's answer instead of timing out first.
ORDER_SERVICE_URL=http://localhost:8083
PAYMENT_REMOTE_TIMEOUT_MS=3000

ROUTE_INTELLIGENCE_URL=http://localhost:8000
DELIVERY_ROUTE_CONNECT_TIMEOUT_MS=1000
DELIVERY_ROUTE_TIMEOUT_MS=3000

# Compose demo: published ports and a trusted model trained in Linux.
API_GATEWAY_PORT=8080
ROUTE_INTELLIGENCE_PORT=8000
WEB_PORT=3000
ROUTE_INTELLIGENCE_MODEL_DIR=./services/route-intelligence-service/artifacts/segment-model-v1

# Compose demo only: bound each Java heap and size JVM thread pools for two CPUs.
DEMO_JAVA_TOOL_OPTIONS=-Xms64m -Xmx384m -XX:ActiveProcessorCount=2
